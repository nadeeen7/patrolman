# This file documents the supported AVA_* settings; it is never read itself.
# Copy it to .env in the PROJECT ROOT (not in backend/) and edit that copy. The
# backend command-line entry points (python -m backend, python -m backend.app)
# load the project-root .env at startup, and only AVA_* keys are accepted.
# Precedence: an exported PowerShell variable always wins over the file, so
# Start-Patrolman.ps1 and Windows Credential Manager keep working unchanged.
# Values are never printed, and .env is git-ignored. AVA_ENV_FILE may point at
# a different file when an installation keeps its settings elsewhere.
#
# Optional AVA_*_PATH overrides. When unset, backend startup discovers existing
# supported installations; relative overrides resolve from the project root.
AVA_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# Exact hostnames/IPs only; no wildcards or automatic subdomain permission.
AVA_ALLOWED_TARGETS=127.0.0.1,localhost
# Enable only for an explicitly authorized local lab.
AVA_ALLOW_PRIVATE_TARGETS=true
AVA_DATA_DIR=data
# Optional loopback port; change it if another local service already uses 5055.
AVA_PORT=5055
# Exact local directories; use semicolons on Windows (os.pathsep). Each entry
# must be one absolute, existing directory with no quotes or trailing spaces;
# links, reparse points, network shares and parent traversal are refused.
AVA_ALLOWED_LOCAL_ROOTS=
# Optional absolute or project-root-relative native binary or Ruby/Perl script paths;
# these are paths, never command strings. Export values before launch.
AVA_NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
AVA_WHATWEB_PATH=tools\whatweb\WhatWeb-0.6.4\whatweb
AVA_HTTPX_PATH=tools\httpx\httpx.exe
AVA_NUCLEI_PATH=tools\nuclei\nuclei.exe
AVA_GITLEAKS_PATH=tools\gitleaks\gitleaks.exe
AVA_SSLYZE_PATH=.venv\Scripts\sslyze.exe
# Wapiti is a Python package installed into the project virtual environment.
AVA_WAPITI_PATH=.venv\Scripts\wapiti.exe
AVA_TRIVY_PATH=tools\trivy\trivy.exe
AVA_SUBFINDER_PROVIDER_CONFIG=
# Approved-binary digest manifest (SHA-256 pins). Defaults to
# backend/approved_binaries.json. A digest mismatch, a missing pinned binary or
# an unreadable manifest refuses execution; PATROLMAN never downloads or
# replaces a binary. An absent manifest (or an absent entry) leaves tools
# unpinned and reports them as unpinned.
AVA_APPROVED_BINARIES=
# Approved local Subfinder binary. Verified v2.17.0: point this at the binary
# extracted from subfinder_2.17.0_windows_amd64.zip after confirming the archive
# SHA-256 matches the release's published subfinder_2.17.0_checksums.txt.
# Enumeration still requires the domain to appear in AVA_ALLOWED_TARGETS.
AVA_SUBFINDER_PATH=tools\subfinder\subfinder.exe
# Dedicated cache; pre-download official DB for vuln checks.
AVA_TRIVY_CACHE_DIR=
AVA_TRIVY_SCANNERS=vuln
# Wapiti web vulnerability assessment.
# Explicit operator opt-in. Installation alone never enables active web
# scanning; leave false unless the assessment is authorized.
AVA_WAPITI_ENABLED=false
# Explicit module list. Never "all" or "common". Defaults to the conservative
# response-inspection set http_headers,cookieflags,csp,methods. Adding an
# injection module is an explicit, per-deployment decision; modules that need
# an out-of-band callback endpoint, brute-force credentials, probe unrelated
# network devices or download extra databases are always refused.
AVA_WAPITI_MODULES=http_headers,cookieflags,csp,methods
# Crawl intensity. Only paranoid, sneaky or polite are accepted.
AVA_WAPITI_SCAN_FORCE=paranoid
# Hard deadlines in seconds. Bounds: scan 10-120, per-module attack 10-120,
# HTTP request timeout 1-30.
AVA_WAPITI_MAX_SCAN_TIME=120
AVA_WAPITI_MAX_ATTACK_TIME=60
AVA_WAPITI_HTTP_TIMEOUT=10
# Wapiti only scans literal-IP base URLs that PATROLMAN already resolved and
# authorized, and only loopback by default. Set true only to permit an
# explicitly authorized non-loopback lab target.
AVA_WAPITI_ALLOW_REMOTE_TARGETS=false
