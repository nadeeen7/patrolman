# PATROLMAN Environment Configuration Example
# Copy this file to .env at the project root and adjust for your local environment.
# Never commit .env to version control or publish real credentials.

# Target Scope & Safety Restrictions
AVA_ALLOWED_TARGETS=127.0.0.1
AVA_ALLOW_PRIVATE_TARGETS=true
AVA_REQUIRE_AUTHORIZED_TARGET=true
AVA_PORT=5055
AVA_DATA_DIR=data

# Local Directory Assessment Scope (semicolon-separated on Windows)
AVA_ALLOWED_LOCAL_ROOTS=C:\Projects\SampleApp

# Optional External API Bearer Token (must be >= 32 characters if set)
# AVA_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
AVA_REQUIRE_API_TOKEN=false

# Wapiti Assessment (disabled by default for safety; explicit operator opt-in)
AVA_WAPITI_ENABLED=false
AVA_WAPITI_MODULES=http_headers,cookieflags,csp,methods
AVA_WAPITI_SCAN_FORCE=paranoid
AVA_WAPITI_MAX_SCAN_TIME=120
AVA_WAPITI_MAX_ATTACK_TIME=60
AVA_WAPITI_HTTP_TIMEOUT=10
AVA_WAPITI_ALLOW_REMOTE_TARGETS=false

# Trusted Web Origins for CORS / CSRF
AVA_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Registration setting
AVA_REGISTRATION_ENABLED=true
